<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
    <record id="view_users_form" model="ir.ui.view">
      <field name="name">Insys Inherit User View</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form"></field>
      <field name="arch" type="xml">
          <xpath expr="//div[@class='oe_title']" position="inside">
            <group>
              <field name="res_user_access" string="User Role"></field>
            </group>
          </xpath>
          <page name="access_rights" position="attributes">
            <attribute name="class" add="insys_readonly_widget" separator=" "/>
          </page>
      </field>
    </record>

    <record id="insys_user_access_tree_view" model="ir.ui.view">
      <field name="name">User Rule View</field>
      <field name="model">insys.user.access</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
          <field name="user_access_type" required="True"></field>
          <field name="user_groups" widget="many2many_tags" options="{'no_create_edit':True,'no_create':True}"></field>
        </tree>
      </field>
    </record>

    <record id="insys_user_access_type_tree_view" model="ir.ui.view">
      <field name="name">User Rule Types</field>
      <field name="model">insys.user.type</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
          <field name="name" required="True"></field>
          <field name="description"></field>
        </tree>
      </field>
    </record>

    <record id="insys_user_access_action" model="ir.actions.act_window">
      <field name="name">Roles</field>
      <field name="res_model">insys.user.access</field>
      <field name="view_mode">list</field>

    </record>

    <record id="insys_user_access_type_action" model="ir.actions.act_window">
      <field name="name">Roles</field>
      <field name="res_model">insys.user.type</field>
      <field name="view_mode">list</field>

    </record>


    <menuitem id="insys_inheirt_user_companies_menu" name="Roles" parent="base.menu_users" action="insys_user_access_action" groups="base.group_system"/>
    <menuitem id="insys__user_rule_type" name="Role Types" parent="base.menu_users" action="insys_user_access_type_action" groups="base.group_system"/>

</odoo>